#!/usr/bin/env bash

set -euo pipefail

PROJECT_DIR="${PREFIX:-}/share/storm-framework"

# Access project directory
cd "$PROJECT_DIR" || { echo "[*] ERROR: Failed to access project directory."; exit 1; }

# Helper: Validasi dependency
check_deps() {
    for cmd in jq curl; do
        if ! command -v "$cmd" >/dev/null 2>&1; then
            echo "[*] ERROR: Required command '$cmd' is not installed." >&2
            exit 1
        fi
    done
}

# Argument Parsing via Pattern Matching
case "${1:-}" in
    --update)
        if [ "$#" -ne 1 ]; then
            echo "[*] Invalid arguments: $*" >&2
            exit 1
        fi
        exec ./smfupdate --data Termux
        ;;

    -c)
        if [ "${2:-}" != "--crt" ] || [ "$#" -ne 2 ]; then
            echo "[*] Invalid arguments: $*" >&2
            exit 1
        fi

        if [ ! -f "./data/smf_ca.crt" ]; then
            echo "[*] ERROR: ./data/smf_ca.crt not found." >&2
            exit 1
        fi

        cp ./data/smf_ca.crt "$HOME/smf_ca.crt"
        echo "[+] Certificate copied to: $HOME/smf_ca.crt"
        ;;

    -v|--version)
        if [ "$#" -eq 1 ]; then
            check_deps
            version=$(jq -r '.version // empty' data/data.json 2>/dev/null)
            if [ -z "$version" ]; then
                echo "[*] ERROR: Failed to read version from data/data.json" >&2
                exit 1
            fi
            echo "[*] Version: $version"

        elif [ "$#" -eq 2 ] && [ "${2:-}" = "-L" ]; then
            check_deps
            
            current_version=$(jq -r '.version // empty' data/data.json 2>/dev/null)
            latest_version=$(curl -fsSL "https://raw.githubusercontent.com/StormWorld0/storm-framework/main/data/data.json" | jq -r '.version // empty' 2>/dev/null)

            if [ -z "$current_version" ] || [ -z "$latest_version" ]; then
                echo "[*] ERROR: Failed to fetch version data." >&2
                exit 1
            fi

            if [ "$(printf '%s\n%s\n' "$current_version" "$latest_version" | sort -V | tail -n1)" != "$current_version" ]; then
                echo "[*] Update available: $current_version -> $latest_version"
            else
                echo "[*] Already up to date: $current_version"
            fi
        else
            echo "[*] Invalid arguments: $*" >&2
            exit 1
        fi
        ;;

    --cleen)
        if [ "$#" -eq 1 ]; then
            python3 -m scripts.cleaning.clean
        else
            echo "[*] Invalid arguments: $*" >&2
            exit 1
        fi
        ;;

    -h|--help)
        if [ "$#" -ne 1 ]; then
            echo "[*] Invalid arguments: $*" >&2
            exit 1
        fi
        echo
        echo "Arguments:"
        echo "    [-h][--help]     : Displays existing commands"
        echo "    [-v][--version]  : Displays the current version"
        echo "    [-v -L]          : Shows whether the latest update is available"
        echo "    [-c --crt]       : Copying CA to HOME Directory"
        echo "    [--update]       : Update to the latest version"
        echo "    [--clean]        : Cleaning Injection files (If there are)"
        echo
        ;;

    "")
        if [ ! -f "./smfstart" ]; then
            exec ./smfupdate --data Termux
        else
            exec ./smfstart
        fi
        ;;

    *)
        echo "[*] Invalid arguments: $* > Use: $0 --help" >&2
        exit 1
        ;;
esac
