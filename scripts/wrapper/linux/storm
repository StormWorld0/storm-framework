#!/usr/bin/env bash

set -euo pipefail

PROJECT_DIR="/opt/storm-framework"

# Directory validation
cd "$PROJECT_DIR" || { echo "[*] ERROR: Failed to access $PROJECT_DIR"; exit 1; }

# Helper: Dependency checker
check_deps() {
    for cmd in jq curl; do
        if ! command -v "$cmd" >/dev/null 2>&1; then
            echo "[*] ERROR: Required dependency '$cmd' is missing." >&2
            exit 1
        fi
    done
}

# Helper: Resolve non-root target home & ownership
get_target_user_context() {
    if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != "root" ]; then
        TARGET_USER="$SUDO_USER"
        TARGET_HOME=$(getent passwd "$SUDO_USER" | cut -d: -f6)
        TARGET_GID=$(id -g "$SUDO_USER")
    else
        TARGET_USER="$(id -un)"
        TARGET_HOME="$HOME"
        TARGET_GID="$(id -g)"
    fi
}

# Argument Parsing via Pattern Matching
case "${1:-}" in
    --update)
        if [ "$#" -ne 1 ]; then
            echo "[*] Invalid arguments: $*" >&2
            exit 1
        fi
        exec ./smfupdate --data Linux
        ;;

    -c)
        if [ "${2:-}" != "--crt" ] || [ "$#" -ne 2 ]; then
            echo "[*] Invalid arguments: $*" >&2
            exit 1
        fi

        SRC_CERT="./data/smf_ca.crt"
        if [ ! -f "$SRC_CERT" ]; then
            echo "[*] ERROR: Certificate file '$SRC_CERT' not found." >&2
            exit 1
        fi

        get_target_user_context
        DEST_CERT="$TARGET_HOME/smf_ca.crt"

        cp "$SRC_CERT" "$DEST_CERT" || { echo "[*] ERROR: Failed to copy certificate." >&2; exit 1; }

        # Fix ownership if running via sudo so the normal user owns the file
        if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != "root" ]; then
            chown "$TARGET_USER:$TARGET_GID" "$DEST_CERT" || { echo "[*] ERROR: Failed to set certificate ownership." >&2; exit 1; }
        fi

        echo "[+] Certificate copied to: $DEST_CERT"
        ;;

    -v|--version)
        if [ "$#" -eq 1 ]; then
            check_deps
            version=$(jq -r '.version // empty' data/data.json 2>/dev/null)
            if [ -z "$version" ]; then
                echo "[*] ERROR: Failed to read version from data/data.json" >&2
                exit 1
            fi
            echo "[*] Version: $version"

        elif [ "$#" -eq 2 ] && [ "${2:-}" = "-L" ]; then
            check_deps
            
            current_version=$(jq -r '.version // empty' data/data.json 2>/dev/null)
            latest_version=$(curl -fsSL "https://raw.githubusercontent.com/StormWorld0/storm-framework/main/data/data.json" | jq -r '.version // empty' 2>/dev/null)

            if [ -z "$current_version" ] || [ -z "$latest_version" ]; then
                echo "[*] ERROR: Failed to fetch version data." >&2
                exit 1
            fi

            if [ "$(printf '%s\n%s\n' "$current_version" "$latest_version" | sort -V | tail -n1)" != "$current_version" ]; then
                echo "[*] Update available: $current_version -> $latest_version"
            else
                echo "[*] Already up to date: $current_version"
            fi
        else
            echo "[*] Invalid arguments: $*" >&2
            exit 1
        fi
        ;;

    --clean)
        if [ "$#" -eq 1 ]; then
            python3 -m scripts.cleaning.clean
        else
            echo "[*] Invalid arguments: $*" >&2
            exit 1
        fi
        ;;

    -w)
        if [ "$#" -eq 3 ] && [ "${2:-}" = "--api" ]; then
            if grep -q '^GOOGLE_API=' .env 2>/dev/null; then
                current_api=$(grep '^GOOGLE_API=' .env | cut -d'=' -f2-)

                if [ "$current_api" = "$3" ]; then
                    echo "[*] API already exists"
                else
                    sed -i "s/^GOOGLE_API=.*/GOOGLE_API=$3/" .env
                    echo "[+] API successfully updated"
                fi
            else
                {
                    echo
                    echo "# Any Google API"
                    echo "GOOGLE_API=$3"
                } >> .env

                echo "[+] API successfully added"
            fi
        else
            echo "[*] Invalid arguments: $*" >&2
            exit 1
        fi
        ;;

    -h|--help)
        if [ "$#" -ne 1 ]; then
            echo "[*] Invalid arguments: $*" >&2
            exit 1
        fi
        echo
        echo "Arguments:"
        echo "    [-h][--help]     : Displays existing commands"
        echo "    [-v][--version]  : Displays the current version"
        echo "    [-v -L]          : Shows whether the latest update is available"
        echo "    [-c --crt]       : Copying CA to HOME Directory"
        echo "    [-w --api]       : Adding Google APIs for OSINT needs"
        echo "    [--update]       : Update to the latest version"
        echo "    [--clean]        : Cleaning Injection files (If there are)"
        echo
        ;;

    "")
        if [ ! -f "./smfstart" ]; then
            exec ./smfupdate --data Linux
        else
            exec ./smfstart
        fi
        ;;

    *)
        echo "[*] Invalid arguments: $* > Use: storm --help" >&2
        exit 1
        ;;
esac
